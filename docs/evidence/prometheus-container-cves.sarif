                  "HIGH"
                ]
              }
            },
            {
              "id": "CVE-2026-78669",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-78669"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-78669?s=golang&n=net&ns=golang.org%2Fx&t=golang&vr=%3C0.60.0",
              "help": {
                "text": "A malicious HTTP/2 peer can cause excessive CPU consumption in the client or server by opening a large number of streams and then sending many small SETTINGS frames containing SETTINGS_INITIAL_WINDOW_SIZE values.\n",
                "markdown": "> A malicious HTTP/2 peer can cause excessive CPU consumption in the client or server by opening a large number of streams and then sending many small SETTINGS frames containing SETTINGS_INITIAL_WINDOW_SIZE values.\n\n|                                                    |\n|Package         pkg:golang/golang.org/x/net@0.58.0  |\n|Affected range  <0.60.0                             |\n|Fixed version   0.60.0                              |\n"
              },
              "properties": {
                "affected_version": ">=1.27.0-0,<1.27.2",
                "cvssV3_severity": "HIGH",
                "fixed_version": "1.27.2",
