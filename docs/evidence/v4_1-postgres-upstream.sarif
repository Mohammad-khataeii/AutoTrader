            {
              "id": "CVE-2026-97032",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-97032"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-97032?s=golang&n=stdlib&t=golang&vr=%3C1.26.9",
              "help": {
                "text": "HTTP/2 servers could end up crashing due to inadvertently modifying its HPACK encoder concurrently. This happens because the server modifies the HPACK encoder from two goroutines without synchronization: one uses the encoder to encode a HEADERS frame as part of a response sent to a client and the other modifies the encoder's table size when handling a SETTINGS frame containing SETTINGS_HEADER_TABLE_SIZE that a client sends. A malicious client can repeatedly send a request while changing the header table size to crash the server.\n",
                "markdown": "> HTTP/2 servers could end up crashing due to inadvertently modifying its HPACK encoder concurrently. This happens because the server modifies the HPACK encoder from two goroutines without synchronization: one uses the encoder to encode a HEADERS frame as part of a response sent to a client and the other modifies the encoder's table size when handling a SETTINGS frame containing SETTINGS_HEADER_TABLE_SIZE that a client sends. A malicious client can repeatedly send a request while changing the header table size to crash the server.\n\n|                                          |\n|Package         pkg:golang/stdlib@1.24.6  |\n|Affected range  <1.26.9                   |\n|Fixed version   1.26.9                    |\n"
              },
              "properties": {
                "affected_version": "<1.26.9",
                "cvssV3_severity": "HIGH",
                "fixed_version": "1.26.9",
                "purls": [
                  "pkg:golang/stdlib@1.24.6"
                ],
                "security-severity": "7.5",
                "tags": [
