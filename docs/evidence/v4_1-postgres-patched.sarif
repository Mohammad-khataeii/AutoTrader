{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "fullName": "Docker Scout",
          "informationUri": "https://docker.com/products/docker-scout",
          "name": "docker scout",
          "rules": [
            {
              "id": "CVE-2026-86140",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-86140"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-86140?s=alpine&n=libxml2&ns=alpine&t=apk&osn=alpine&osv=3.24&vr=%3C%3D2.13.9-r2",
              "help": {
                "text": "\n",
                "markdown": "> \n\n|                                                                                 |\n|Package         pkg:apk/alpine/libxml2@2.13.9-r2?os_name=alpine&os_version=3.24  |\n|Affected range  <=2.13.9-r2                                                      |\n|Fixed version   not fixed                                                        |\n"
              },
              "properties": {
                "affected_version": "<=2.13.9-r2",
                "cvssV3_severity": "HIGH",
                "fixed_version": "not fixed",
                "purls": [
                  "pkg:apk/alpine/libxml2@2.13.9-r2?os_name=alpine&os_version=3.24"
                ],
                "security-severity": "8.0",
                "tags": [
                  "HIGH"
                ]
              }
            }
          ],
          "version": "1.25.0"
        }
      },
      "results": [
        {
          "ruleId": "CVE-2026-86140",
          "ruleIndex": 0,
          "kind": "fail",
          "level": "error",
          "message": {
            "text": "Vulnerability    :CVE-2026-86140                                                   \nSeverity         :HIGH                                                             \nPackage          :pkg:apk/alpine/libxml2@2.13.9-r2?os_name=alpine&os_version=3.24  \nAffected range   :<=2.13.9-r2                                                      \nFixed version    :not fixed                                                        \nEPSS Score       :0.001570                                                         \nEPSS Percentile  :0.044150                                                         \n"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/lib/apk/db/installed"
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/usr/lib/libxml2.so.2.13.9"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
