            {
              "id": "CVE-2026-21728",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-21728: Uncontrolled Resource Consumption"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-21728?s=github&n=tempo&ns=github.com%2Fgrafana&t=golang&vr=%3E%3D1.3.0%2C%3C2.8.4",
              "help": {
                "text": "Tempo queries with large limits can cause large memory allocations which can impact the availability of the service, depending on its deployment strategy.\n\nMitigation can be done by setting max_result_limit in the search config, e.g. to 262144 (2^18).\n",
                "markdown": "> Tempo queries with large limits can cause large memory allocations which can impact the availability of the service, depending on its deployment strategy.\n\nMitigation can be done by setting max_result_limit in the search config, e.g. to 262144 (2^18).\n\n|                                                                                                                                                        |\n|Package                                                                        pkg:golang/github.com/grafana/tempo@1.5.1-0.20260910130453-bcfe9f230c1d  |\n|Affected range                                                                 >=1.3.0,<2.8.4                                                           |\n|Fixed version                                                                  2.8.4                                                                    |\n|[[CVSS Score 7.5] [CVSS Vector CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H]]                                                                           |\n"
              },
              "properties": {
                "affected_version": ">=1.3.0,<2.8.4",
                "cvssV3": 7.5,
                "cvssV3_severity": "HIGH",
                "cvssV3_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H",
