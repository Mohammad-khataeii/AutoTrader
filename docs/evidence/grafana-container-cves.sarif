            {
              "id": "CVE-2026-78669",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-78669"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-78669?s=golang&n=stdlib&t=golang&vr=%3E%3D1.27.0-0%2C%3C1.27.2",
              "help": {
                "text": "A malicious HTTP/2 peer can cause excessive CPU consumption in the client or server by opening a large number of streams and then sending many small SETTINGS frames containing SETTINGS_INITIAL_WINDOW_SIZE values.\n",
