ENVIRONMENT=production
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD
DATABASE_URL=postgresql+asyncpg://autotrader:REPLACE_WITH_STRONG_POSTGRES_PASSWORD@postgres:5432/autotrader
REDIS_URL=redis://redis:6379/0
REVOLUT_X_REGION=EEA
PAPER_TRADING_ENABLED=true
LIVE_TRADING_ENABLED=false
AI_PROVIDER=mock
AI_MODEL=
# Paid AI requires a configured official model, account access verification and
# current pricing verified against https://developers.openai.com/api/docs/pricing
# No example price or model is asserted as an account entitlement.
AI_INPUT_PRICE_PER_MILLION=
AI_CACHED_INPUT_PRICE_PER_MILLION=
AI_CACHE_WRITE_PRICE_PER_MILLION=
AI_OUTPUT_PRICE_PER_MILLION=
AI_PRICING_VERIFIED_AT=
AI_MAX_ANALYSES_PER_DAY=30
AI_MAX_ANALYSES_PER_HOUR=6
AI_REQUIRE_PERSISTENT_QUOTA=true
AI_TIMEOUT_SECONDS=12
WORKER_SCAN_INTERVAL_SECONDS=60
WORKER_POSITION_INTERVAL_SECONDS=5
INITIAL_CASH_EUR=500
AI_MONTHLY_BUDGET_USD=10
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
