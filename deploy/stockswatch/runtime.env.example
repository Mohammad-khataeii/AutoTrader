# Copy outside the source tree, set permissions to 0600, then enter server-side values.
# Use the full paper account UUID or full account number. Dashboard displays a suffix.
STOCKSWATCH_ALPACA_PAPER_ACCOUNT_ID=
STOCKSWATCH_ALPACA_PAPER_KEY=
STOCKSWATCH_ALPACA_PAPER_SECRET=
STOCKSWATCH_ALPACA_KEY=
STOCKSWATCH_ALPACA_SECRET=
# Optional allowlisted scanner settings are inherited from the original StocksWatch container.
# Supply an explicit replacement here only if needed.
# STOCKSWATCH_SEC_USER_AGENT=
# STOCKSWATCH_GEMINI_ENABLED=
# STOCKSWATCH_TICK_SECONDS=
# Default intraday observation is IEX single venue. SIP requires entitlement.
# STOCKSWATCH_INTRADAY_FEED=iex
# STOCKSWATCH_INTRADAY_OVERNIGHT_FEED=overnight
# STOCKSWATCH_INTRADAY_REQUIRE_ALL_VALID=0
# Keep order activation outside this first-cutover credentials file.

# Paper-only adaptive entry: defer EOD buys until fresh intraday stabilization.
# STOCKSWATCH_EOD_ENTRY_MODE=adaptive
