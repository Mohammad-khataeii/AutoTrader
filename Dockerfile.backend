FROM python:3.12-alpine

WORKDIR /app
ENV PYTHONUNBUFFERED=1
RUN apk upgrade --no-cache
RUN python -m pip install --no-cache-dir --upgrade pip==26.2.1
COPY --chmod=0644 pyproject.toml ./
COPY --chmod=0644 requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
COPY src ./src
# Reject a release where the backend application version does not match the packaged source.
RUN python -c 'import re,tomllib; from pathlib import Path; v=tomllib.loads(Path("pyproject.toml").read_text())["project"]["version"]; v=re.sub(r"rc([0-9]+)$",r"-rc.\1",v); s=Path("src/autotrader/api/main.py").read_text(); assert ("version=\""+v+"\"") in s, "backend source/version mismatch"'
COPY alembic ./alembic
COPY --chmod=0644 docs/evidence/v4_6_rc2/research-comparison.json /app/evidence/v46/comparison-v46-rc2.json
COPY --chmod=0644 docs/evidence/v4_7/research-results.json /app/evidence/v47/research-results.json
COPY --chmod=0644 docs/evidence/v4_7_1/research-results.json /app/evidence/v471/research-results.json
COPY --chmod=0644 docs/evidence/v4_8/research-results.json /app/evidence/v48/research-results.json
COPY --chmod=0644 docs/evidence/v4_9/research-results.json /app/evidence/v49/research-results.json
COPY --chmod=0644 alembic.ini ./
RUN find /app/src /app/alembic /app/evidence -type d -exec chmod 0755 {} + \
    && find /app/src /app/alembic /app/evidence -type f -exec chmod 0644 {} +
RUN pip install --no-cache-dir --no-deps .
RUN python -m pip uninstall -y pip setuptools wheel
RUN adduser -S -D -u 10001 paper
ARG RELEASE_COMMIT=unbound
ENV AUTOTRADER_RELEASE_COMMIT=${RELEASE_COMMIT}
LABEL org.opencontainers.image.revision=${RELEASE_COMMIT}
USER paper
EXPOSE 8000
CMD ["autotrader-api"]

